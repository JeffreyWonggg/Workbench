# ===== 个人数据（绝对不要提交）=====
# 工作台的数据文件夹：待办、周报、笔记、加密资料库都在这里
notes/
# 加密资料库的密文与备份（即使在 notes/ 之外也一并挡住）
vault.json
vault.backup.json
# 局域网传文件收下来的东西
lan/
# 剪贴板历史（含你复制过的内容，可能包含密码）
clipboard-history.json
# 本机记录的自建产品目录
catalog.db
# 扫盘生成的路径索引快照（含产品实际路径，随时可重新扫描）
catalog-index.json

# ===== 密钥（绝对不要提交）=====
js/openrouter.local.js

# ===== 本机配置与缓存（换机器会自己重建）=====
workbench.config.json

# ===== 从服务器同步来的索引库（几十 MB，随时可重新同步）=====
otdr_index.db
*.db

# ===== 编译产物（用 scripts/build-host.ps1 重新编译）=====
scripts/workbench-host.exe
scripts/workbench-host.exe.bak
scripts/workbench-host.prev.exe
*.pdb
# 换版时留在 js/vendor/ 的旧第三方库备份（几百 KB，需要时重新下载即可）
*.bak.js

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.codebuddy/
Thumbs.db
desktop.ini
*.swp

# ===== 开发期临时探针 =====
# 排障时在根目录生成的临时页面/脚本/截图（约定用下划线开头），不该进版本库。
# 只匹配根目录，不影响子目录里正常的文件名。
/_*.html
/_*.js
/_*.png
